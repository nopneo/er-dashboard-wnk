# คัดลอกเป็น .env แล้ว chmod 600 (ห้าม commit ไฟล์ .env)
# ใช้บัญชีฐานข้อมูลที่ "อ่านอย่างเดียว" (SELECT) เท่านั้น
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hos
DB_USER=<readonly_user>
DB_PASS=<password>
PORT=6200

# ---- ค่าเสริม (ไม่ใส่ก็ได้) — ความหมายดู INSTALL.md หัวข้อ 4
# ER_HOSPITAL_NAME=โรงพยาบาล...
# ER_HOSPITAL_NAME_EN=... HOSPITAL
# ER_CONTACT=งานสารสนเทศ โทร 1234

# ---- รหัสของ HOSxP (ค่าเริ่มต้น = รหัสมาตรฐาน) — เปิดหน้า /check ดูว่าตรงกับข้อมูลของ รพ. หรือไม่ (INSTALL.md ข้อ 0, 6)
# ER_DEPCODE=011
# ER_NOT_DEPCODES=999
# ER_ST_DOCTOR_COL=service5
# ER_WALKIN_CODES=01,05      (ovstist: ลงทะเบียนเอง / Kiosk)
# ER_APPT_CODES=02           (ovstist: มาตามนัด)
# ER_REFER_IN_CODES=03       (ovstist: รับส่งต่อ)
# ER_EMS_ALS_CODES=04        (ovstist: EMS ALS)
# ER_EMS_FR_CODES=06         (ovstist: EMS FR)
# ER_PDX_DIAGTYPE=1          (ovstdiag.diagtype ของวินิจฉัยหลัก)
# ER_SVC_PT_TYPES=4          (er_pt_type: รับบริการ ทำแผล ฉีดยา)
# ER_AUTOPSY_PT_TYPES=6      (er_pt_type: ชันสูตรศพ)
# ER_DCH_HOME=1  ER_DCH_REFER=2  ER_DCH_ADMIT=3  ER_DCH_OBS=5  ER_DCH_REFUSE=7  ER_DCH_ESCAPE=8   (er_dch_type)
# ER_NURSE_PROVIDER_TYPES=03  ER_DOCTOR_PROVIDER_TYPES=01  ER_DOCTOR_POSITION_IDS=1   (รายงานพยาบาลตรวจแทนแพทย์)
# ER_DATA_AUDITED=0          (1 = ตรวจกับข้อมูลของ รพ. แล้ว — ซ่อนแถบเตือนบนแดชบอร์ด)
# ER_LAN_NETS=               (เครือข่ายเพิ่มที่เปิดหน้า /check ได้ เช่น IP สาธารณะของ รพ. เมื่อเข้าผ่าน Cloudflare)
# ER_CHECK_OPEN=0            (1 = เปิดหน้า /check ได้ทุกที่ — ไม่แนะนำ)

# ER_BOARDING_MIN=120
# ER_RED_MAX_MIN=60
# ER_MCI_MIN=5
# ER_MCI_WINDOW=60
# ER_MAX_DAYS=366
# ER_NP_PASS_HASH='pbkdf2:sha256:...'   (hash ของรหัสเข้าดูรายงานพยาบาลตรวจแทนแพทย์ — ดู INSTALL.md)
# ER_NP_OPEN=0   (1 = เปิดรายงานพยาบาลโดยไม่ใช้รหัส — เฉพาะ LAN)
# ER_SECRET_KEY=<สุ่ม 64 ตัวอักษร>
# ER_NP_LOGIN_HOURS=12
# ER_TRUSTED_PROXIES=127.0.0.1,::1
# ER_CF_RANGES=<ช่วง IP ของ Cloudflare — ค่าเริ่มต้นตาม cloudflare.com/ips>
# ER_CACHE_TTL=120
# ER_MAX_BUILDS=2
# ER_BUILD_WAIT=60
# ER_DB_TIMEOUT=60
# ER_EXPORT=1
# ER_EXPORT_WAIT=0
# ER_EXPORT_CACHE_TTL=300

# ---- พัฒนาบนเครื่องที่ไม่มีรหัส DB: ยิง SQL ผ่าน ssh (ไม่ต้องใส่ DB_PASS)
# ER_DB_MODE=ssh
# ER_SSH_HOST=<ssh-host-ที่รัน-mariadb-ได้>
